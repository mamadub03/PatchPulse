PATCHPULSE_APP_NAME=PatchPulse API
PATCHPULSE_ENVIRONMENT=local
PATCHPULSE_API_PREFIX=/api/v1
PATCHPULSE_ALLOWED_FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/patchpulse
PATCHPULSE_DEV_USER_EMAIL=dev@patchpulse.local
GITHUB_TOKEN=
PATCHPULSE_REQUIREMENTS_MAX_BYTES=1000000
PATCHPULSE_OSV_API_URL=https://api.osv.dev
PATCHPULSE_OSV_CONNECT_TIMEOUT_SECONDS=5
PATCHPULSE_OSV_READ_TIMEOUT_SECONDS=20
